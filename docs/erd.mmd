erDiagram
    AUTH_USERS o|--|| PROFILES : authenticates
    PROFILES ||--o| ASSIGNMENTS : receives
    ACADEMIC_PROGRAMS o|--o{ PROFILES : studies
    PROGRAMS ||--o{ ASSIGNMENTS : governs
    ASSIGNMENTS ||--o{ SUBMISSIONS : submits
    PROGRAMS ||--o{ SUBMISSIONS : evaluated_under
    SUBMISSIONS ||--o{ HISTORY : records
    PROFILES ||--o{ HISTORY : acts
    AUTH_USERS {
        uuid id PK
        text email
    }
    PROFILES {
        uuid id PK
        uuid auth_user_id FK,UK
        text email UK
        text student_id UK
        text test_case_id UK
        text academic_program_code FK
        integer year_level
        text section
        text profile_academic_year
        text full_name
        text role
        timestamptz created_at
    }
    PROGRAMS {
        uuid id PK
        text name UK
        numeric max_gwa
        integer min_units
        integer max_failed
        integer max_incomplete
        integer max_dropped
        timestamptz deadline
    }
    ACADEMIC_PROGRAMS {
        text code PK
        text name
        text college
        text level
        text source_url
        text source_note
    }
    ASSIGNMENTS {
        uuid scholar_id PK,FK
        uuid program_id FK
        text award_status
        timestamptz assigned_at
    }
    SUBMISSIONS {
        uuid id PK
        uuid scholar_id FK
        uuid program_id FK
        text academic_year "Composite unique with scholar_id and semester"
        integer semester
        numeric gwa
        integer units
        integer failed
        integer incomplete
        integer dropped
        text evidence_ref
        timestamptz submitted_at
        text verification
        text verification_reason
        text compliance
        jsonb checks
        jsonb reasons
        text renewal
        text decision_notes
        timestamptz updated_at
    }
    HISTORY {
        uuid id PK
        uuid submission_id FK
        uuid actor_id FK
        text action
        text notes
        jsonb snapshot
        timestamptz created_at
    }
